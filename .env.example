# Copy this file to ".env" and fill it in. DO NOT commit ".env".

# ── Home Assistant (main router) ────────────────────────────────────────────
HA_URL=http://192.168.1.10:8123
# User profile → Security → "Long-lived access tokens"
HA_TOKEN=
HA_VERIFY_SSL=true

# ── Secondary GL.iNet / OpenWrt access point over SSH (optional) ────────────
# Leave OPAL_HOST empty to use the main router only.
OPAL_HOST=192.0.2.2
OPAL_PORT=22
OPAL_USER=root
OPAL_PASSWORD=
# Instead of a password: private key (recommended)
# OPAL_KEY=/path/to/key_ed25519
# If set, the host key is verified (otherwise it is accepted on first contact)
# OPAL_KNOWN_HOSTS=/path/to/known_hosts
OPAL_AP_IF=wlan0          # access point interface
OPAL_STA_IF=wlan-sta0     # client interface that uplinks to the main router
# Physical LAN port(s) of the secondary AP, to recognise wired devices (see README)
# OPAL_LAN_IF=eth0.1
# OPAL_BRIDGE=br-lan
# In addition/alternatively: wired MACs listed by hand
# OPAL_WIRED_MACS=aa:bb:cc:00:00:02

# ── Uplink detection ───────────────────────────────────────────────────────
# Part of the name of the AP the secondary AP MUST be attached to, as reported by the router; empty = no alert
# UPLINK_EXPECTED_AP=AX55
# Mesh extenders (part of the name is enough) to tell them apart in roaming events
# EXTENDER_NAMES=RE700X
# Router/extender MACs, used only when the router does not report which AP a client is on
# AX55_MAC=
# RE700X_MAC=

# ── Behaviour ─────────────────────────────────────────────────────────────
POLL_SECONDS=30
RETENTION_DAYS=14
RSSI_GOOD=-60
RSSI_WARN=-75
UPLINK_WARN=-70
NEW_DEVICE_HOURS=48
# Alert when these types stay offline (comma separated; empty = never) for more than N minutes
OFFLINE_ALERT_TYPES=camera,rete
OFFLINE_ALERT_MINUTES=10

# ── Data (default: next to app.py; use a dedicated folder in production) ──
# DB_PATH=/var/lib/netmap/network.db
# NAMES_FILE=/var/lib/netmap/names.json
# META_FILE=/var/lib/netmap/meta.json

# ── Optional protection (HTTP Basic) ──────────────────────────────────────
# DASH_USER=admin
# DASH_PASSWORD=

# ── Logs ──────────────────────────────────────────────────────────────────
# NETMAP_LANG=en           # language of the LOGS: en (default) or it. The page language is chosen in the browser
# LOG_LEVEL=INFO           # DEBUG adds tracebacks and the time of every SSH command
# LOG_FILE=netmap.log      # optional (rotation 1 MB x 3); it always logs to stdout too
